# Maintainer: yatui contributors
# VCS package: builds the current main branch. The release tarball does not
# exist yet, so the checksum of a tag cannot be pinned here.
pkgname=yatui-git
pkgver=r0.0.0
pkgrel=1
pkgdesc="Yandex Music client for the terminal"
arch=('x86_64' 'aarch64')
url="https://github.com/phantom-lancer/yatui"
license=('GPL-3.0-only')
depends=('libx11' 'alsa-lib')
makedepends=('go')
provides=('yatui')
conflicts=('yatui')
source=("git+https://github.com/phantom-lancer/yatui.git")
sha256sums=('SKIP')

pkgver() {
	cd yatui
	printf 'r%s.%s' "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

build() {
	cd yatui
	export CGO_ENABLED=1
	go build -trimpath -ldflags="-w -s" -o yatui .
}

package() {
	cd yatui
	install -Dm755 yatui "$pkgdir/usr/bin/yatui"
	install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
	install -Dm644 THIRD_PARTY_NOTICES.md "$pkgdir/usr/share/licenses/$pkgname/THIRD_PARTY_NOTICES.md"
}
